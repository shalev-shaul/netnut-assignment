{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach: API (9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "name": "Attach: Job Manager (9230)",
      "type": "node",
      "request": "attach",
      "port": 9230,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "name": "Attach: Scraper (9231)",
      "type": "node",
      "request": "attach",
      "port": 9231,
      "restart": true,
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "name": "Attach: Scraper (Docker 9231)",
      "type": "node",
      "request": "attach",
      "address": "localhost",
      "port": 9231,
      "restart": true,
      "localRoot": "${workspaceFolder}/apps/scraper",
      "remoteRoot": "/app/apps/scraper",
      "skipFiles": ["<node_internals>/**"],
      "sourceMaps": true
    },
    {
      "name": "Launch: API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/api",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nest", "start", "--debug", "--watch"],
      "console": "integratedTerminal",
      "restart": true,
      "envFile": "${workspaceFolder}/apps/api/.env",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch: Job Manager",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/job-manager",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nest", "start", "--debug", "--watch"],
      "console": "integratedTerminal",
      "restart": true,
      "envFile": "${workspaceFolder}/apps/job-manager/.env",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Launch: Scraper",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/scraper",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["nest", "start", "--debug", "--watch"],
      "console": "integratedTerminal",
      "restart": true,
      "envFile": "${workspaceFolder}/apps/scraper/.env",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "Attach All",
      "configurations": [
        "Attach: API (9229)",
        "Attach: Job Manager (9230)",
        "Attach: Scraper (9231)"
      ],
      "stopAll": true
    }
  ]
}
