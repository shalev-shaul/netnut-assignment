{
  "name": "netnut-assignment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:api": "nest build api",
    "build:job-manager": "nest build job-manager",
    "build:scraper": "nest build scraper",
    "build:all": "npm run build:api && npm run build:job-manager && npm run build:scraper",
    "start:api": "node dist/apps/api/apps/api/src/main",
    "start:job-manager": "node dist/apps/job-manager/apps/job-manager/src/main",
    "start:scraper": "node dist/apps/scraper/apps/scraper/src/main",
    "start:dev:api": "nest start api --watch",
    "start:dev:job-manager": "nest start job-manager --watch",
    "start:dev:scraper": "nest start scraper --watch",
    "debug:api": "nest start api --debug=0.0.0.0:9229 --watch",
    "debug:job-manager": "nest start job-manager --debug=0.0.0.0:9230 --watch",
    "debug:scraper": "nest start scraper --debug=0.0.0.0:9231 --watch"
  },
  "dependencies": {
    "@nestjs/bull": "^10.2.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "axios": "^1.7.2",
    "bull": "^4.16.3",
    "bullmq": "^5.8.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "https-proxy-agent": "^7.0.5",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
    "@types/bull": "^4.10.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
