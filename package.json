{
  "name": "netnut-assignment",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "libs/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm run build -w @netnut/shared",
    "build": "npm run build:shared && npm run build -w @netnut/api && npm run build -w @netnut/job-manager && npm run build -w @netnut/scraper",
    "start:api": "npm run start -w @netnut/api",
    "start:job-manager": "npm run start -w @netnut/job-manager",
    "start:scraper": "npm run start -w @netnut/scraper",
    "start:dev:api": "npm run start:dev -w @netnut/api",
    "start:dev:job-manager": "npm run start:dev -w @netnut/job-manager",
    "start:dev:scraper": "npm run start:dev -w @netnut/scraper",
    "debug:api": "npm run debug -w @netnut/api",
    "debug:job-manager": "npm run debug -w @netnut/job-manager",
    "debug:scraper": "npm run debug -w @netnut/scraper"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.2",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
